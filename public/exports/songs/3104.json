      "label": "Verse 1",
      "lines": [
        {
          "text": "हे स्वर्गीय पिता"
        },
        {
          "text": "तेरे नाम की स्तुति हो"
        },
        {
          "text": "हे जीवनदाता"
        },
        {
          "text": "तेरे सन्मुख आते हम"
        },
        {
          "text": "..repeat"
        }
      ]
    },
    {
      "type": "verse",
      "label": "Chorus",
      "lines": [
        {
          "text": "आराधना, हो.. आराधना"
        },
        {
          "text": "आराधना, हो.. आराधना"
        }
      ]
    },
    {
      "type": "verse",
      "label": "Verse 2",
      "lines": [
        {
          "text": "तेरे सिवा कोई नही"
        },
        {
          "text": "आराधना के योग्य"
        },
        {
          "text": "तेरे समान कोई नही"
        },
        {
          "text": "स्वर्ग में या पृथ्वी में"
        }
      ]
    }
  ],
